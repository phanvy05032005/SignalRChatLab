<script>
    document.addEventListener('DOMContentLoaded', () => {
        const consoleViewport = document.getElementById('consoleViewport');
        const consoleInput = document.getElementById('consoleInput');
        const consoleSendBtn = document.getElementById('consoleSendBtn');
        const glassConsole = document.getElementById('glassConsole');

        let botSteps = 0;
        const botResponses = [
            (name) => `Great to meet you, ${name}! Yes, that message was delivered instantly. SignalR keeps a lightweight TCP connection open to ensure latency stays under 10ms.`,
            () => `By the way, you can also paste images, upload attachments, and type custom messenger emojis in the real workspace!`,
            () => `Click the "Launch Application" button at the top right to start a real-time session, sign in, and test it live with others!`,
            () => `You've completed the demo! Ready to explore? Go ahead and join the live room.`
        ];

        // Soft tilt effect on console container on mouse movement
        document.addEventListener('mousemove', (e) => {
            const width = window.innerWidth;
            const height = window.innerHeight;
            const mouseX = e.clientX - width / 2;
            const mouseY = e.clientY - height / 2;
            
            const rX = (mouseY / height) * 8; // Max 4 degrees rotation
            const rY = -(mouseX / width) * 8;
            
            glassConsole.style.transform = `rotateX(${rX}deg) rotateY(${rY}deg) translateY(-2px)`;
        });

        // Send a message
        const sendMessage = () => {
            const text = consoleInput.value.trim();
            if (!text) return;

            // Render User Bubble
            renderBubble(text, 'user', 'You');
            consoleInput.value = '';

            // Simulated response logic
            setTimeout(() => {
                let botReply = '';
                if (botSteps === 0) {
                    botReply = botResponses[0](text);
                    botSteps++;
                } else {
                    const index = Math.min(botSteps, botResponses.length - 1);
                    botReply = botResponses[index]();
                    botSteps++;
                }
                renderBubble(botReply, 'bot', 'SignalR-Bot');
            }, 800);
        };

        const renderBubble = (content, sender, senderName) => {
            const bubbleDiv = document.createElement('div');
            bubbleDiv.className = `chat-bubble bubble-${sender}`;
            
            const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            
            bubbleDiv.innerHTML = `
                <div class="chat-meta">
                    <strong>${senderName}</strong> • ${time}
                </div>
                <div>${escapeHtml(content)}</div>
            `;
            
            consoleViewport.appendChild(bubbleDiv);
            consoleViewport.scrollTop = consoleViewport.scrollHeight;
        };

        const escapeHtml = (unsafe) => {
            return unsafe
                 .replace(/&/g, "&amp;")
                 .replace(/</g, "&lt;")
                 .replace(/>/g, "&gt;")
                 .replace(/"/g, "&quot;")
                 .replace(/'/g, "&#039;");
        };

        consoleInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        consoleSendBtn.addEventListener('click', sendMessage);
    });
</script>
